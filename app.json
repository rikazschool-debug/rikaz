{
  "expo": {
    "name": "ركاز",
    "slug": "rikaz-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#006560"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rikazschool.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.rikazschool.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
