# Rikaz Mobile — انسخ هذا الملف إلى .env
# كل المتغيرات هنا عامة وتُضمَّن في التطبيق؛ لا تضع فيها أي سر (مفتاح الخادم يبقى في المنصة فقط).

EXPO_PUBLIC_SUPABASE_URL=https://api.kalmalki.com
# مفتاح anon العام المقروء من واجهة VPS المنشورة؛ لا تستخدم مفتاح السحابة أو service_role.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzk0NDIzNDY2LCJleHAiOjE5NTIxMDM0NjZ9.nO1XUcCt8gLM1WPBscRJXeVsVKh-7GR1ImbOZwMDm40

# عنوان منصة ركاز على الويب
EXPO_PUBLIC_PLATFORM_URL=https://app.kalmalki.com
# أصل خدمات الدخول المخصصة، مستقل عن عنوان قاعدة VPS. لا تضف /api/public/auth هنا.
EXPO_PUBLIC_AUTH_API_URL=https://app.kalmalki.com

# الدخول برقم الهوية (الطالب، ولي الأمر، الموظفون): 0 حتى تُنشأ نقاط الدخول في المنصة
# (انظر docs/VPS_CONNECTION.md). اضبطه على 1 فقط بعد نشر الخدمات وقبولها.
EXPO_PUBLIC_MOBILE_ID_LOGIN=0
