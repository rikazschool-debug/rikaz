{
  "name": "rikaz-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "start": "expo start",
    "replit:dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN BROWSER=none pnpm exec expo start --go --localhost --port $PORT --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "clear": "expo start -c",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.14",
    "@expo-google-fonts/cairo": "0.2.3",
    "@expo/log-box": "~57.0.5",
    "@expo/metro-runtime": "~57.0.18",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~57.0.33",
    "expo-constants": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.576.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.17",
    "create-launch": "0.4.1",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "tar": "7.5.23"
    }
  }
}
