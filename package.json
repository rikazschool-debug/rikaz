{
  "name": "rikaz-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "start": "expo start",
    "replit:dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then ../artifacts/mobile/node_modules/.bin/create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "clear": "expo start -c",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.14",
    "@expo-google-fonts/cairo": "0.2.3",
    "@expo/metro-runtime": "~3.2.3",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.7",
    "expo-linear-gradient": "~13.0.2",
    "expo-modules-core": "1.12.26",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "lucide-react-native": "^0.453.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.43",
    "@types/react": "~18.2.45",
    "jest": "^29.7.0",
    "typescript": "~5.3.3"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "tar": "7.5.23"
    }
  }
}
